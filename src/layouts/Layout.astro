---
import BaseHead from "../components/BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  description?: string;
  title: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="ja" class="bg-steel text-snow font-sans">
  <BaseHead title={title} description={description} />
  <body
    class="grid-areas-body grid min-h-svh grid-cols-[0_1fr_0] grid-rows-[auto_1fr_auto] gap-4 md:grid-cols-[1fr_auto_1fr]"
  >
    <Header class="grid-area-header" />
    <main class="grid-area-main md:w-2xl">
      <slot />
    </main>
    <Footer class="grid-area-footer" />
  </body>
</html>
