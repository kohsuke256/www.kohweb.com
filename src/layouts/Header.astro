---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class:list={[
    "header grid grid-cols-[1fr] grid-rows-[auto_auto] place-items-center px-4 md:grid-cols-[auto_1fr] md:grid-rows-[auto] md:justify-items-end md:px-8",
    className,
  ]}
>
  <a href="/"><h1 class="my-3 text-3xl font-bold">kohweb.com</h1></a>

  <nav>
    <ul class="flex justify-end gap-4 text-xl">
      <li><a href="/">Home</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/history">History</a></li>
    </ul>
  </nav>
</header>
