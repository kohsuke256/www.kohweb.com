---

<header class="header">
  <a href="/"><h1>kohweb.com</h1></a>

  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/history">History</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    display: grid;
    place-items: center;

    @media (width >= 800px) {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto;
      gap: 16px;
      justify-items: right;
    }
    @media (width < 800px) {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    a {
      display: contents;
      color: inherit;
      text-decoration: none;
    }

    nav ul {
      display: flex;
      justify-content: end;
      list-style-type: none;
      padding-inline: 0;
      gap: 16px;
      font-size: large;
    }
  }
</style>
