---
interface Props {
  year: number;
  month?: number;
}

const { year, month } = Astro.props;
const datetime =
  month !== undefined ? `${year}-${("0" + month).slice(-2)}` : `${year}`;
---

<div
  class:list={[
    "border-silver bg-iron ms-6 mt-2 grid grid-cols-[auto_1fr] grid-rows-[auto] place-items-start gap-4 rounded-lg border",
    "not-last:relative not-last:mb-6",
    'not-last:after:bg-accent-800 not-last:after:clip-path-triangle-down not-last:after:absolute not-last:after:top-[calc(100%+1em)] not-last:after:right-0 not-last:after:left-0 not-last:after:mx-auto not-last:after:block not-last:after:h-[1em] not-last:after:w-[2em] not-last:after:content-[""]',
  ]}
>
  <dt
    class:list={[
      "grid-area-[1/1] relative -ms-6 -mt-2 mb-2 grid font-bold",
      {
        'grid-areas-["year_year_l"_"year_year_l"_"b_b_m"] grid-cols-[1fr_2em_auto] grid-rows-[1fr_1em_auto]':
          month !== undefined,
        'grid-areas-["year"] grid-cols-[auto] grid-rows-[auto]':
          month == undefined,
      },
    ]}
  >
    <time class="contents" datetime={datetime}>
      <span
        class="year grid-area-[year] bg-accent-800 border-silver relative grid aspect-square w-fit place-items-center rounded-full border px-2 text-xl whitespace-nowrap"
      >
        <span>
          {year}<span class="text-[0.75em]">年</span>
        </span>
      </span>
      {
        month !== undefined && (
          <span class="month border-silver grid-area-[2/2/4/4] bg-iron relative grid aspect-square w-fit place-items-center rounded-full border px-2 whitespace-nowrap">
            <span>
              {month}
              <span class="text-[0.75em]">月</span>
            </span>
          </span>
        )
      }
    </time>
  </dt>
  <dd class="grid-area-[1/2] flex flex-col gap-1 py-[0.5lh] pe-4">
    <slot />
  </dd>
</div>
