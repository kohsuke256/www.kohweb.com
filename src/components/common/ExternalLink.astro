---
import Link from "./Link.astro";
import InlineImage from "./InlineImage.astro";
import ExternalLinkIcon from "../../assets/icons/external-link.svg";

interface Props {
  href: string;
  [key: string]: any;
}

const { href, target = "_blank", ...attrs } = Astro.props;
---

<Link {href} {target} {...attrs}>
  <slot />
  <InlineImage src={ExternalLinkIcon.src} alt="外部リンク" />
</Link>
