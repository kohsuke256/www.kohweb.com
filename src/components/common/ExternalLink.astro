---
import Link from "./Link.astro";
import ExternalLinkIcon from "../../assets/icons/external-link.svg";

interface Props {
  href: string;
  [key: string]: any;
}

const { href, target = "_blank", ...attrs } = Astro.props;
---

<Link {href} {target} {...attrs}>
  <slot />
  <img src={ExternalLinkIcon.src} alt="外部リンク" />
</Link>

<style>
  img {
    display: inline-block;
    height: 1em;
  }
</style>
