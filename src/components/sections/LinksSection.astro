---
import DescriptionDetails from "@/components/common/DescriptionDetails.astro";
import DescriptionList from "@/components/common/DescriptionList.astro";
import DescriptionPair from "@/components/common/DescriptionPair.astro";
import DescriptionTerm from "@/components/common/DescriptionTerm.astro";
import ExternalLink from "@/components/common/ExternalLink.astro";
import Heading2 from "@/components/common/heading/Heading2.astro";
---

<section>
  <Heading2>Links</Heading2>
  <DescriptionList>
    <DescriptionPair>
      <DescriptionTerm slot="term"> GitHub </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        <ExternalLink href="https://github.com/kohsuke256"
          >@kohsuke256</ExternalLink
        >
      </DescriptionDetails>
    </DescriptionPair>
    <DescriptionPair>
      <DescriptionTerm slot="term"> X (Twitter) </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        <ExternalLink href="https://x.com/kohsuke256">@kohsuke256</ExternalLink>
        (VLL 人格など)
      </DescriptionDetails>
      <DescriptionDetails slot="descriptions">
        <ExternalLink href="https://x.com/kohsuke255">@kohsuke255</ExternalLink>
        (日常人格など)
      </DescriptionDetails>
    </DescriptionPair>
  </DescriptionList>
</section>
