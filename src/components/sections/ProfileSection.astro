---
import DescriptionDetails from "@/components/common/DescriptionDetails.astro";
import DescriptionList from "@/components/common/DescriptionList.astro";
import DescriptionPair from "@/components/common/DescriptionPair.astro";
import DescriptionTerm from "@/components/common/DescriptionTerm.astro";
import ExternalLink from "@/components/common/ExternalLink.astro";
import Heading2 from "@/components/common/heading/Heading2.astro";
import InlineImage from "@/components/common/InlineImage.astro";

import EmailAdressImage from "@/assets/texts/email.svg";
---

<section>
  <Heading2>Profile</Heading2>
  <DescriptionList>
    <DescriptionPair>
      <DescriptionTerm slot="term"> 名前 </DescriptionTerm>
      <DescriptionDetails slot="descriptions"> コウスケ </DescriptionDetails>
      <DescriptionDetails slot="descriptions"> Kohsuke </DescriptionDetails>
    </DescriptionPair>
    <DescriptionPair>
      <DescriptionTerm slot="term"> 生年 </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        <time datetime="2005">2005年</time>
      </DescriptionDetails>
    </DescriptionPair>
    <DescriptionPair etc>
      <DescriptionTerm slot="term"> 所属 </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        <ExternalLink href="https://www.uec.ac.jp/">電気通信大学</ExternalLink> 情報理工学域
      </DescriptionDetails>
      <DescriptionDetails slot="descriptions">
        <ExternalLink href="https://mikuec.com/"
          >バーチャルライブ研究会</ExternalLink
        >（通称：<abbr title="Virtual Live Lab">VLL</abbr>）
      </DescriptionDetails>
    </DescriptionPair>
    <DescriptionPair etc>
      <DescriptionTerm slot="term"> 資格・試験 </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        応用情報技術者試験（<abbr
          title="Applied Information Technology Engineer Examination">AP</abbr
        >） 合格
      </DescriptionDetails>
      <DescriptionDetails slot="descriptions">
        三級知的財産管理技能士
      </DescriptionDetails>
    </DescriptionPair>
    <DescriptionPair>
      <DescriptionTerm slot="term"> 連絡先 </DescriptionTerm>
      <DescriptionDetails slot="descriptions">
        <InlineImage
          src={EmailAdressImage.src}
          alt="スパム対策のため画像化されたメールアドレス"
        />
      </DescriptionDetails>
    </DescriptionPair>
  </DescriptionList>
</section>
